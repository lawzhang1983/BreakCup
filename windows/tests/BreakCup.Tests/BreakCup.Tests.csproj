<Project Sdk="Microsoft.NET.Sdk">

  <!-- 核心逻辑单测：直接编译 src/BreakCup/Core 的源码，用 dotnet run 执行 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BreakCup.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\BreakCup\Core\**\*.cs" LinkBase="Core" />
  </ItemGroup>

</Project>
